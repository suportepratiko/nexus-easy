# ============ PostgreSQL (Docker) ============
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# URL de conexão do backend. Deve usar o MESMO usuário e senha do Postgres em execução.
# Se o login der "password authentication failed", ajuste abaixo para bater com o seu banco.
DATABASE_URL=postgresql://app:app_secret@localhost:5432/app_db

# ============ Frontend (Vite) ============
# URL do backend da API Safirion (FastAPI)
VITE_API_URL=http://localhost:8001

# ============ Backend FastAPI (Safirion / Corretora) ============
SAFIRION_HOST=ws.trade.safirion.com        # Host do WebSocket
SAFIRION_API_HOST=api.trade.safirion.com   # Host da API HTTP (login, logout, etc)

# ============ Segurança ============
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=TROQUE-POR-UM-SEGREDO-FORTE-AQUI

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_ENC_KEY=TROQUE-POR-UMA-CHAVE-FERNET-AQUI

# Origens permitidas (produção). Separe por vírgula.
# ALLOWED_ORIGINS=https://nexusbot.pratiko.app.br

# Segredo interno para push (troque por algo aleatório)
# INTERNAL_PUSH_SECRET=TROQUE-AQUI

# ============ PWA Push (notificações) ============
# Chaves em .vapid_webpush.json (geradas por node scripts/ensure-vapid.cjs).
# Subject do JWT VAPID (Apple/Safari rejeita mailto com domínio .local). Opcional.
# VAPID_SUBJECT=mailto:noreply@seudominio.com
# Segredo para o bot disparar push (defina o mesmo no processo do bot via env).
# INTERNAL_PUSH_SECRET=change-me-internal
# BACKEND_URL=http://127.0.0.1:8001
